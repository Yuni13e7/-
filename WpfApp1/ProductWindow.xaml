<Window x:Class="WpfApp1.ProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="Продукты" Height="800" Width="1200">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Чудо обувь" VerticalAlignment="Stretch" HorizontalAlignment="Center" Margin="0 20" FontSize="35" />
        <Image Source="/Res/Чудо Обувь.png" HorizontalAlignment="Left" VerticalAlignment="Center"/>
        <Grid Grid.Row="1" HorizontalAlignment="Left" Name="AdminPanel">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <StackPanel Margin="20 0 20 0" Grid.Column="0">
                <TextBlock Text="Поиск"></TextBlock>
                <TextBox Name="SearchingTextBox" Width="200" TextChanged="SearchingTextBox_TextChanged"></TextBox>
            </StackPanel>
            <StackPanel Margin="20 0 20 0" Grid.Column="1">
                <TextBlock Text="Сортировка"></TextBlock>
                <ComboBox Name="SortingComboBox" Width="200" SelectionChanged="SortingComboBox_SelectionChanged">
                    <ComboBoxItem Content="По умолчанию"/>
                    <ComboBoxItem Content="По возрастанию"/>
                    <ComboBoxItem Content="По убыванию"/>
                </ComboBox>

            </StackPanel>
            <StackPanel Margin="20 0 20 0" Grid.Column="2">
                <TextBlock Text="Фильтрация"></TextBlock>
                <ComboBox Name="FilteringComboBox" Width="200" SelectionChanged="FilteringComboBox_SelectionChanged">
                    <ComboBoxItem Content="Все категории"/>
                    <ComboBoxItem Content="Детская обувь"/>
                    <ComboBoxItem Content="Женская обувь"/>
                    <ComboBoxItem Content="Мужская обувь"/>
                </ComboBox>

            </StackPanel>

        </Grid>
            

        <TextBlock Name="FullUserName" Margin=" 20 20 20 0" HorizontalAlignment="Right" Width="300" />
        <ScrollViewer Grid.Row="2">
            <ItemsControl Name="ProductList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="10" Background="{Binding Background}" Cursor="Hand" MouseLeftButtonUp="Border_MouseLeftButtonUp">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"  Width="100" Height="100" Margin="15 0">
                                    <Image Source="{Binding image}"/>
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock HorizontalAlignment="Center" FontSize="25" TextWrapping="Wrap">
                                        <Run Text="{Binding manufacturers.name}"/>
                                        <Run Text=" | "/>
                                        <Run Text="{Binding name}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding categories.name}"/>
                                    <TextBlock Text="{Binding StockQuantityTotal}"/>
                                    <TextBlock Text="{Binding composition}" TextWrapping="Wrap"/>

                                </StackPanel>
                                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Column="2">
                                    <TextBlock Text="Цена:"/>
                                    <TextBlock Text="{Binding OldPrice, StringFormat=C2}" Visibility="{Binding OldPriceVisibility}" Foreground="Red" TextDecorations="Strikethrough" Margin="10"/>
                                    <TextBlock Text="{Binding FinalPrice, StringFormat=C2}"/>

                                </StackPanel>
                              
                            </Grid>
                            
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Button Name="LogOutButton" Content="Выйти" Grid.Row="1" Width="200" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="20 0" Click="LogOutButton_Click" />

    </Grid>
</Window>
