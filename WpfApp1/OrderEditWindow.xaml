<Window x:Class="WpfApp1.OrderEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="OrderEditWindow" Height="450" Width="800">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0 0 0 15">
            <StackPanel Orientation="Horizontal" Margin="0 0 0 10">
                <TextBlock Text="Дата заказа: " VerticalAlignment="Center" FontWeight="Bold"/>
                <!-- Дата доступна для редактирования только админу -->
                <DatePicker x:Name="OrderDatePicker" Width="150" Margin="5 0"/>
                <Button x:Name="SaveDateBtn" Content="Сохранить дату" Click="SaveDate_Click" Margin="10 0 0 0" Visibility="Collapsed"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <Button Content="Добавить товар" Width="150" Height="30" Click="AddItem_Click" Margin="0 0 10 0"/>
                <Button Content="Удалить позицию" Width="150" Height="30" Click="RemoveItem_Click"/>
            </StackPanel>
        </StackPanel>

        <DataGrid x:Name="ItemsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Товар" Binding="{Binding ProductName}" Width="*"/>
                <DataGridTextColumn Header="Производитель" Binding="{Binding ManufacturerName}" Width="150"/>
                <DataGridTextColumn Header="Размер" Binding="{Binding SizeValue}" Width="80"/>
                <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="80"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding PricePerUnit, StringFormat=\{0:N2\} ₽}" Width="100"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding Total, StringFormat=\{0:N2\} ₽}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="TotalText" Grid.Row="2" FontSize="18" FontWeight="Bold" HorizontalAlignment="Right" Margin="0 10 0 0"/>
    </Grid>
</Window>
