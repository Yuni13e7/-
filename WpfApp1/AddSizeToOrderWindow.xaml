<Window x:Class="WpfApp1.AddSizeToOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="Добавление в заказ" Height="400" Width="500" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock x:Name="ProductNameText" FontSize="20" FontWeight="Bold" Margin="0 0 0 15" TextWrapping="Wrap"/>

            <TextBlock Text="Размер:" Margin="0 10 0 0"/>
            <ComboBox x:Name="SizeComboBox" Width="200" HorizontalAlignment="Left" DisplayMemberPath="SizeValue"/>

            <TextBlock Text="Количество:" Margin="0 10 0 0"/>
            <TextBox x:Name="QuantityTextBox" Width="200" HorizontalAlignment="Left" Text="1"/>

            <StackPanel Orientation="Horizontal" Margin="0 30 0 0">
                <Button Content="Добавить" Width="120" Height="35" Click="Add_Click"/>
                <Button Content="Отмена" Width="120" Height="35" Margin="10 0 0 0" Click="Cancel_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
