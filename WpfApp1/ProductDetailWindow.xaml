<Window x:Class="WpfApp1.ProductDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="ProductDetailWindow" Height="800" Width="1000">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая колонка: изображение -->
        <Image Grid.Column="0" 
               Source="{Binding image}" 
               Stretch="Uniform" 
               Margin="10"/>

        <!-- Правая колонка: данные и выбор -->
        <StackPanel Grid.Column="1" Margin="20 0 0 0">
            <TextBlock Text="{Binding manufacturers.name}" FontSize="16" Foreground="Gray"/>
            <TextBlock Text="{Binding name}" FontSize="24" FontWeight="Bold" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding categories.name}" FontSize="16" Margin="0 5"/>

            <!-- Цена -->
            <StackPanel Orientation="Horizontal" Margin="0 10">
                <TextBlock Text="{Binding FinalPrice, StringFormat={}{0:N2} ₽}" 
                           FontSize="20" FontWeight="Bold"/>
                <TextBlock Text="{Binding OldPrice, StringFormat=' ({0:N2} ₽)'}" 
                           Foreground="Gray" 
                           TextDecorations="Strikethrough"
                           FontSize="16" 
                           Visibility="{Binding OldPriceVisibility}"/>
            </StackPanel>

            <TextBlock Text="Состав:" FontWeight="Bold" Margin="0 10 0 0"/>
            <TextBlock Text="{Binding composition}" TextWrapping="Wrap"/>

            <TextBlock Text="Описание:" FontWeight="Bold" Margin="0 10 0 0"/>
            <TextBlock Text="{Binding description}" TextWrapping="Wrap"/>

            <!-- Выбор размера -->
            <TextBlock Text="Размер:" FontWeight="Bold" Margin="0 15 0 0"/>
            <ComboBox Name="SizeComboBox" Width="200" DisplayMemberPath="SizeValue"/>

            <!-- Выбор количества -->
            <TextBlock Text="Количество:" FontWeight="Bold" Margin="0 10 0 0"/>
            <TextBox Name="QuantityTextBox" Width="200" Text="1"/>

            <!-- Кнопки -->
            <StackPanel Orientation="Horizontal" Margin="0 20 0 0">
                <Button Content="Добавить в заказ" Width="180" Height="40" 
                        Click="AddToCart_Click"/>
                <Button Content="Отмена" Width="120" Height="40" 
                        Margin="10 0 0 0" Click="Cancel_Click"/>
            </StackPanel>

            <!-- Кнопка оформить (если в корзине что-то есть) -->
            <Button Content="Оформить заказ" Width="180" Height="40" 
                    Margin="0 15 0 0" Click="Checkout_Click"/>
        </StackPanel>
    </Grid>
</Window>
