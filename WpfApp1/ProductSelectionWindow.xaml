<Window x:Class="WpfApp1.ProductSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="Выбор товара" Height="450" Width="800">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBox x:Name="SearchBox" Grid.Row="0" Width="300" HorizontalAlignment="Left" Margin="0 0 0 15" TextChanged="SearchBox_TextChanged"/>

        <ListBox x:Name="ProductsList" Grid.Row="1" MouseDoubleClick="ProductsList_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Margin="5" Padding="10" Background="#F0F0F0">
                        <StackPanel>
                            <TextBlock Text="{Binding name}" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="{Binding manufacturers.name}"/>
                            <TextBlock Text="{Binding categories.name}"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
